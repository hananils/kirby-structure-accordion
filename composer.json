{
    "name": "hananils/kirby-structure-accordion",
    "description": "Structure Accordion is an alternative approach to structured data management in Kirby. It features an accordion user interface with inline editor, batch editing functions and advanced search capabilities. For multilingual sites, it automatically synchronises content between languages.",
    "license": "MIT",
    "type": "kirby-plugin",
    "version": "1.0.0-dev",
    "authors": [
        {
            "name": "hana+nils · Büro für Gestaltung",
            "email": "buero@hananils.de"
        }
    ],
    "homepage": "https://kirby.hananils.de/plugins/structure-accordion",
    "require": {
        "hananils/kirby-plugins": "^1.0",
        "getkirby/composer-installer": "^1.2"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/hananils/kirby-plugins.git"
        }
    ],
    "autoload": {
        "psr-4": {
            "Hananils\\Fields\\": "fields"
        }
    },
    "config": {
        "allow-plugins": {
            "getkirby/composer-installer": true
        }
    },
    "extra": {
        "installer-name": "structure-accordion",
        "kirby": {
            "compatible": "~6.0"
        }
    }
}
